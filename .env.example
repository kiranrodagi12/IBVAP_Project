# IBVAP Environment Configuration
# Copy to .env and customize

# Application
DEBUG=True
DEMO_MODE=True

# Database (default: SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./ibvap.db

# For production with PostGIS:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ibvap

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AI / YOLO
YOLO_ENABLED=False
YOLO_MODEL_PATH=../ai/models/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
